# LIDRA systemd service unit
#
# To override paths (non-default install location, custom venv, etc.):
#   1. Create the override file:
#        sudo mkdir -p /etc/systemd/system/lidra.service.d
#        sudo tee /etc/systemd/system/lidra.service.d/override.conf <<'EOF'
#        [Service]
#        Environment=LIDRA_ROOT=/your/path
#        ExecStart=/your/path/venv/bin/python3 /your/path/src/lidra_agent_v3.py --no-tui
#        EOF
#   2. Reload: sudo systemctl daemon-reload && sudo systemctl restart lidra
#
# (A drop-in is used rather than an EnvironmentFile template: the previous
# comment pointed at install/default/lidra, which never existed in this repo.)

[Unit]
Description=LIDRA Intrusion Detection & Response Agent
Documentation=https://github.com/anomalyco/lidra
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=lidra
WorkingDirectory=/opt/lidra
# ponytail: --no-tui — no TTY under systemd; a spawned TUI would fail/spam.
# Restart=always (not on-failure) — a clean-exit crash still leaves you blind.
ExecStart=/opt/lidra/venv/bin/python3 /opt/lidra/src/lidra_agent_v3.py --no-tui
Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1
Environment=LIDRA_ROOT=/opt/lidra

# IPC socket home. systemd creates /run/lidra owned root:lidra mode 0750 so
# the operator (added to the `lidra` group at install) can attach the TUI
# without being root. /run is a tmpfs: stale sockets vanish on reboot, and —
# unlike /tmp — it is not split by PrivateTmp, so the documented `lidra tui`
# attach works from a normal shell. See utils/runtime.py.
RuntimeDirectory=lidra
RuntimeDirectoryMode=0750

LimitNOFILE=65536
LimitNPROC=4096
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/lidra /var/log/lidra /run/lidra

StandardOutput=append:/var/log/lidra/service.log
StandardError=append:/var/log/lidra/service_error.log

[Install]
WantedBy=multi-user.target
